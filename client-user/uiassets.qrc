        <file alias="profile.svg">assets/icons/profile.svg</file>
        <file alias="profile-active.svg">assets/icons/profile-active.svg</file>

        <file alias="phone.svg">assets/icons/phone.svg</file>
        <file alias="search.svg">assets/icons/search.svg</file>
        <file alias="location.svg">assets/icons/location.svg</file>

        <file alias="back.svg">assets/icons/back.svg</file>
        <file alias="refresh.svg">assets/icons/refresh.svg</file>

        <file alias="navigation.svg">assets/icons/navigation.svg</file>
        <file alias="navigation-white.svg">assets/icons/navigation-white.svg</file>

        <file alias="car.svg">assets/icons/car.svg</file>
        <file alias="walk.svg">assets/icons/walk.svg</file>

        <file alias="wallet.svg">assets/icons/wallet.svg</file>
        <file alias="wallet-white.svg">assets/icons/wallet-white.svg</file>

