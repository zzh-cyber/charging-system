# ---- 构建产物（绝不提交）----
build/
build-*/
cmake-build-*/
out/

# Spark coalesce 临时目录（保留 qa/report.json 与 dwd csv）
bigdata/work/**/_spark/
# ADS 产物默认忽略。用 ads/* 才能再放行两份大屏快照。
bigdata/work/ads/*
!bigdata/work/ads/kpis/
!bigdata/work/ads/kpis/dashboard.json
!bigdata/work/ads/user_groups/
!bigdata/work/ads/user_groups/dashboard.json
!bigdata/work/ads/user_groups/users.json
dashboard/ads_snapshot.json
dashboard.log

# ---- CMake 中间文件 ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.cmake.stamp
compile_commands.json

# ---- 编译产物 ----
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
moc_*.cpp
qrc_*.cpp
ui_*.h

# ---- 可执行文件 ----
charging-server
charging-user
charging-admin

# ---- Qt / Qt Creator ----
*.pro.user
*.pro.user.*
*.autosave
.qmake.stash

# ---- IDE ----
.vscode/
.idea/
*.swp
*~

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- Python（第二阶段 bigdata/ 脚本）----
__pycache__/
*.pyc
# 上面的 out/ 会忽略任意名为 out 的目录。全组统一的 ODS 夹具要入库：
# 先放开目录，再只取消忽略三份 csv（与 dq_expected.json 对齐，答辩机生成）。
!bigdata/out/
bigdata/out/*
!bigdata/out/ods_station.csv
!bigdata/out/ods_pile.csv
!bigdata/out/ods_charge_order.csv

# ---- 备份 ----
backup/

# ---- 本地开发配置（不提交）----
local.env
